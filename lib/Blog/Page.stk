## lib/Blog/Page.stk — `use Blog::Page`
##
## HTML templates. Every page shares one HUD shell (`layout`): the stryke
## docs header, Theme / CRT / Neon toggles, the colour-scheme strip, and
## theme/hud-theme.js. `$rel` is the path prefix back to the site root
## ("" for top-level pages, "../" for posts/ and tags/), so the output works
## from any base path — the GitHub Pages project site or file://.

package Blog::Page

fn Blog::Page::esc ($s) { html_encode($s // "") }

fn Blog::Page::tag_href ($rel, $tag) { $rel . "tags/" . slugify($tag) . ".html" }

fn Blog::Page::tag_links ($rel, $tags) {
    join " ", map { qq{<a class="post-tag" href="} . Blog::Page::tag_href($rel, $_) . qq{">#} . Blog::Page::esc($_) . "</a>" } @$tags
}

## "2026-10-30 · 3 min · #a #b" line used on cards and post headers.
fn Blog::Page::meta_line ($rel, $post) {
    my $line = qq{<time datetime="$post->{date}">$post->{date}</time>}
    $line .= qq{ <span class="sep">·</span> $post->{minutes} min read}
    $line .= qq{ <span class="sep">·</span> } . Blog::Page::tag_links($rel, $post->{tags}) if @{ $post->{tags} }
    $line
}

fn Blog::Page::card ($rel, $post) {
    val $href    = $rel . "posts/$post->{slug}.html"
    val $title   = Blog::Page::esc($post->{title})
    val $summary = length $post->{summary} ? qq{\n  <p class="post-card-summary">} . Blog::Page::esc($post->{summary}) . "</p>" : ""
    val $meta    = Blog::Page::meta_line($rel, $post)
    <<"HTML"
<article class="post-card">
  <div class="post-meta">$meta</div>
  <h3 class="post-card-title"><a href="$href">$title</a></h3>$summary
</article>
HTML
}

## Full HTML document. %a keys: site, rel, title, heading, subtitle, body,
## description, path (site-relative URL path of this page), current.
fn Blog::Page::layout (%a) {
    val $site     = $a{site}
    val $rel      = $a{rel} // ""
    val $doctitle = Blog::Page::esc(defined $a{title} ? "$a{title} — $site->{title}" : $site->{title})
    val $desc     = Blog::Page::esc($a{description} // $site->{description})
    val $canon    = Blog::Page::esc($site->{base_url} . "/" . ($a{path} // ""))
    val $brand    = Blog::Page::esc(uc "// $site->{title} — $site->{tagline}")
    val $heading  = Blog::Page::esc($a{heading} // $site->{title})
    val $subtitle = defined $a{subtitle} ? qq{\n      <p class="tutorial-subtitle">$a{subtitle}</p>} : ""
    val $repo     = Blog::Page::esc($site->{repo})
    val $stats    = "$site->{post_count} posts · $site->{tag_count} tags"
    my $crumbs = ""
    for my $c (["Posts", "index.html"], ["Archive", "archive.html"], ["Tags", "tags/index.html"], ["Feed", "feed.xml"]) {
        val ($label, $href) = @$c
        $crumbs .= qq{\n            <span class="sep">/</span>} if length $crumbs
        $crumbs .= ($a{current} // "") eq $label
            ? qq{\n            <span class="current">$label</span>}
            : qq{\n            <a href="$rel$href">$label</a>}
    }
    <<"HTML"
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="description" content="$desc">
  <title>$doctitle</title>
  <link rel="canonical" href="$canon">
  <link rel="alternate" type="application/atom+xml" title="$site->{title}" href="${rel}feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&amp;family=Share+Tech+Mono&amp;display=swap" rel="stylesheet">
  <link rel="stylesheet" href="${rel}assets/hud-static.css">
  <link rel="stylesheet" href="${rel}assets/tutorial.css">
  <link rel="stylesheet" href="${rel}assets/blog.css">
</head>
<body>
  <div class="app tutorial-app" id="blogApp">
    <div class="crt-scanline" id="crtH" aria-hidden="true"></div>
    <div class="crt-scanline-v" id="crtV" aria-hidden="true"></div>

    <header class="tutorial-header">
      <div class="tutorial-header-inner">
        <div>
          <h1 class="tutorial-brand"><a href="${rel}index.html">$brand</a></h1>
          <nav class="tutorial-crumbs" aria-label="Sections">$crumbs
          </nav>
          <p class="blog-build-line">$stats</p>
        </div>
        <div class="tutorial-toolbar">
          <button type="button" class="btn btn-secondary" id="btnTheme" title="Toggle light/dark">Theme</button>
          <button type="button" class="btn btn-secondary active" id="btnCrt" title="CRT scanline overlay">CRT</button>
          <button type="button" class="btn btn-secondary active" id="btnNeon" title="Neon border pulse">Neon</button>
          <a class="btn btn-secondary" href="${rel}feed.xml">Feed</a>
          <a class="btn btn-secondary" href="$repo" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </header>

    <div class="hub-scheme-strip">
      <div class="hub-scheme-strip-inner">
        <span class="hud-scheme-label">// Color scheme</span>
        <div class="scheme-grid" id="hudSchemeGrid"></div>
      </div>
    </div>

    <main class="tutorial-main blog-main">
      <h2 class="tutorial-title"><span class="step-hash">&gt;_</span>$heading</h2>$subtitle
$a{body}
    </main>

    <footer class="blog-footer">
      <span>// $site->{title}</span>
      <span class="sep">·</span>
      <a href="https://github.com/MenkeTechnologies" target="_blank" rel="noopener noreferrer">github</a>
      <span class="sep">·</span>
      <a href="${rel}feed.xml">atom feed</a>
    </footer>
  </div>

  <script src="${rel}assets/hud-theme.js"></script>
</body>
</html>
HTML
}

fn Blog::Page::index ($site, $posts) {
    val $cards = @$posts
        ? join("", map { Blog::Page::card("", $_) } @$posts)
        : qq{<p class="blog-empty">No transmissions yet. Add a Markdown file under <code>posts/</code> and run <code>s build.stk</code>.</p>\n}
    Blog::Page::layout(
        site     => $site,
        path     => "",
        current  => "Posts",
        heading  => $site->{title},
        subtitle => Blog::Page::esc($site->{description}),
        body     => qq{      <section class="post-list">\n$cards      </section>},
    )
}

fn Blog::Page::post ($site, $post, $newer, $older) {
    val $rel  = "../"
    val $meta = Blog::Page::meta_line($rel, $post)
    my $nav = qq{      <nav class="tutorial-nav" aria-label="Post navigation">\n}
    $nav .= $older
        ? qq{        <a class="nav-prev" href="$older->{slug}.html"><span class="nav-label">Older</span><span class="nav-title">} . Blog::Page::esc($older->{title}) . "</span></a>\n"
        : qq{        <span class="nav-stub nav-prev"><span class="nav-label">Older</span><span class="nav-title">—</span></span>\n}
    $nav .= qq{        <a class="nav-index" href="../index.html"><span class="nav-label">All posts</span></a>\n}
    $nav .= $newer
        ? qq{        <a class="nav-next" href="$newer->{slug}.html"><span class="nav-label">Newer</span><span class="nav-title">} . Blog::Page::esc($newer->{title}) . "</span></a>\n"
        : qq{        <span class="nav-stub nav-next"><span class="nav-label">Newer</span><span class="nav-title">—</span></span>\n}
    $nav .= "      </nav>"
    Blog::Page::layout(
        site        => $site,
        rel         => $rel,
        path        => "posts/$post->{slug}.html",
        title       => $post->{title},
        heading     => $post->{title},
        description => length $post->{summary} ? $post->{summary} : undef,
        subtitle    => qq{<span class="post-meta">$meta</span>},
        body        => qq{      <article class="tutorial-section post-body">\n$post->{html}      </article>\n$nav},
    )
}

fn Blog::Page::archive ($site, $posts) {
    my %by_year
    push @{ $by_year{$_->{year}} }, $_ for @$posts
    my $body = ""
    for my $year (sort { $b <=> $a } keys %by_year) {
        $body .= qq{      <section class="tutorial-section archive-year">\n        <h2>$year</h2>\n        <ul class="archive-list">\n}
        for my $p (@{ $by_year{$year} }) {
            $body .= qq{          <li><time datetime="$p->{date}">$p->{date}</time> <a href="posts/$p->{slug}.html">} . Blog::Page::esc($p->{title}) . "</a></li>\n"
        }
        $body .= "        </ul>\n      </section>\n"
    }
    Blog::Page::layout(
        site    => $site,
        path    => "archive.html",
        title   => "Archive",
        heading => "Archive",
        current => "Archive",
        body    => $body,
    )
}

## $tags: arrayref of [tag, [posts...]] sorted by count desc then name.
fn Blog::Page::tag_index ($site, $tags) {
    val $cloud = join "\n", map { qq{        <a class="post-tag" href="} . slugify($_->[0]) . qq{.html">#} . Blog::Page::esc($_->[0]) . qq{ <span class="tag-count">} . scalar(@{ $_->[1] }) . "</span></a>" } @$tags
    Blog::Page::layout(
        site    => $site,
        rel     => "../",
        path    => "tags/index.html",
        title   => "Tags",
        heading => "Tags",
        current => "Tags",
        body    => qq{      <section class="tutorial-section tag-cloud">\n$cloud\n      </section>},
    )
}

fn Blog::Page::tag ($site, $tag, $posts) {
    val $cards = join "", map { Blog::Page::card("../", $_) } @$posts
    Blog::Page::layout(
        site     => $site,
        rel      => "../",
        path     => "tags/" . slugify($tag) . ".html",
        title    => "#$tag",
        heading  => "#$tag",
        current  => "Tags",
        subtitle => scalar(@$posts) . (scalar(@$posts) == 1 ? " post" : " posts") . qq{ tagged <code>} . Blog::Page::esc($tag) . "</code>",
        body     => qq{      <section class="post-list">\n$cards      </section>},
    )
}

fn Blog::Page::not_found ($site) {
    # GitHub Pages serves 404.html from any depth, so links must be absolute.
    Blog::Page::layout(
        site     => $site,
        rel      => $site->{base_path} . "/",
        path     => "404.html",
        title    => "404",
        heading  => "404 // Signal lost",
        subtitle => qq{No page at this address. <a href="$site->{base_path}/index.html">Back to all posts</a>.},
        body     => "",
    )
}

## Atom 1.0 feed of the newest $limit posts. Dates are midnight UTC of the
## post's front-matter date, so the feed is byte-stable across rebuilds.
fn Blog::Page::feed ($site, $posts, $limit) {
    val $base    = $site->{base_url}
    val $updated = @$posts ? "$posts->[0]{date}T00:00:00Z" : "1970-01-01T00:00:00Z"
    val $title   = Blog::Page::esc($site->{title})
    val $sub     = Blog::Page::esc($site->{description})
    val $author  = Blog::Page::esc($site->{author})
    my $entries = ""
    for my $p (grep { defined } @$posts[0 .. min($limit, scalar @$posts) - 1]) {
        val $url     = "$base/posts/$p->{slug}.html"
        val $ptitle  = Blog::Page::esc($p->{title})
        val $summary = Blog::Page::esc($p->{summary})
        val $content = Blog::Page::esc($p->{html})
        val $cats    = join "", map { qq{\n    <category term="} . Blog::Page::esc($_) . qq{"/>} } @{ $p->{tags} }
        $entries .= <<"XML"
  <entry>
    <title>$ptitle</title>
    <link href="$url"/>
    <id>$url</id>
    <updated>$p->{date}T00:00:00Z</updated>
    <summary>$summary</summary>$cats
    <content type="html">$content</content>
  </entry>
XML
    }
    <<"XML"
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>$title</title>
  <subtitle>$sub</subtitle>
  <link href="$base/feed.xml" rel="self"/>
  <link href="$base/"/>
  <id>$base/</id>
  <updated>$updated</updated>
  <author><name>$author</name></author>
  <generator>stryke</generator>
$entries</feed>
XML
}

1
